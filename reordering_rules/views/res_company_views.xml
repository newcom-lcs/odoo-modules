<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_reordering_rules" model="ir.ui.view">
        <field name="name">res.company.form.inherit.reordering.rules</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Inventory Settings" name="inventory_settings">
                    <group>
                        <group name="inventory_config" string="Configuration">
                            <field name="enable_auto_reordering_rules"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo> 