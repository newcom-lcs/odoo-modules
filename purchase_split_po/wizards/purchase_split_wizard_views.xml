<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_split_wizard_form" model="ir.ui.view">
        <field name="name">purchase.order.split.wizard.form</field>
        <field name="model">purchase.order.split.wizard</field>
        <field name="arch" type="xml">
            <form string="Dividir Líneas de Orden de Compra">
                <sheet>
                    <group>
                        <group>
                            <field name="purchase_order_id" readonly="1"/>
                            <field name="supplier_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <separator string="Seleccionar Acción"/>
                            <field name="action_type" widget="radio"/>
                            <field name="existing_purchase_order_id" 
                                   attrs="{'invisible': [('action_type', '!=', 'existing')], 'required': [('action_type', '=', 'existing')]}"/>
                        </group>
                    </group>
                    
                    <!-- Show lines for selection -->
                    <field name="available_line_ids" invisible="1" attrs="{'invisible': [('available_line_ids', '=', [])]}"/>
                    <field name="line_selection_ids" 
                           options="{'no_create': True, 'no_open': True}"
                           nolabel="1"
                           attrs="{'invisible': [('available_line_ids', '=', [])]}"/>
                </sheet>
                <footer>
                    <button name="action_execute" string="Ejecutar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <!-- Custom tree view for line selection -->
    <record id="view_purchase_line_selection_tree" model="ir.ui.view">
        <field name="name">purchase.split.wizard.line.tree</field>
        <field name="model">purchase.split.wizard.line</field>
        <field name="arch" type="xml">
            <tree create="false" edit="true" delete="false" decoration-success="True">
                <field name="selected" widget="boolean_toggle"/>
                <field name="product_id" readonly="1"/>
                <field name="name" readonly="1"/>
                <field name="product_qty" readonly="1"/>
            </tree>
        </field>
    </record>
</odoo> 