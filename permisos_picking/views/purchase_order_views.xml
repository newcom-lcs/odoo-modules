<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Sales Order button to Purchase Order form -->
    <record id="view_purchase_order_form_inherit_sales_view" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.sales.view</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_view_sales_orders" 
                        string="Ver Órdenes de Venta Relacionadas" 
                        type="object"
                        class="btn-secondary"
                        groups="permisos_picking.group_purchase_sales_viewer"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_qty']" position="after">
                <field name="sale_line_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Sales Orders View for Purchase Team -->
    <record id="view_sale_order_purchase_tree" model="ir.ui.view">
        <field name="name">sale.order.purchase.tree</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <tree string="Sales Orders" decoration-info="state == 'draft'" decoration-success="state == 'sale'" decoration-muted="state == 'cancel'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_order"/>
                <field name="state"/>
                <field name="amount_total" invisible="1"/>
                <field name="amount_untaxed" invisible="1"/>
                <field name="amount_tax" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="pricelist_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_sale_order_purchase_form" model="ir.ui.view">
        <field name="name">sale.order.purchase.form</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <form string="Sales Order" create="false" edit="false">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="date_order" readonly="1"/>
                            <field name="pricelist_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="amount_total" invisible="1"/>
                            <field name="amount_untaxed" invisible="1"/>
                            <field name="amount_tax" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines">
                            <field name="order_line" readonly="1">
                                <tree>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom"/>
                                    <field name="price_unit" invisible="1"/>
                                    <field name="price_subtotal" invisible="1"/>
                                    <field name="price_total" invisible="1"/>
                                    <field name="price_tax" invisible="1"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="discount" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Sales Orders in Purchase -->
    <record id="action_sale_order_purchase" model="ir.actions.act_window">
        <field name="name">Sales Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_sale_order_purchase_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No sales orders found
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_sale_order_purchase"
              name="Sales Orders"
              parent="purchase.purchase_report"
              action="action_sale_order_purchase"
              sequence="100"
              groups="permisos_picking.group_purchase_sales_viewer"/>
</odoo> 